              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 15.369444,\n  \"longitude\": 44.191006\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/donor/nearby-hospitals", "host": ["{{base_url}}"], "path": ["donor", "nearby-hospitals"] }
          }
