{
  "info": {
    "name": "Musaef API - منصة مسعف",
    "description": "مجموعة مسارات API الخاصة بمشروع منصة مسعف متوافقة 100% مع مسارات Laravel Backend وتشتمل على المستشفيات وبنوك الدم والمتبرعين.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. المصادقة (Auth)",
      "item": [
        {
          "name": "تسجيل الدخول (Login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"shifa@musaef.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] }
          }
        },
        {
          "name": "إنشاء حساب متبرع (Register Donor)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"أحمد المتبرع\",\n  \"email\": \"ahmed@donor.com\",\n  \"phone\": \"770000000\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"role\": \"donor\",\n  \"blood_type_id\": 1,\n  \"birth_date\": \"1995-05-20\",\n  \"gender\": \"male\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/register/donor", "host": ["{{base_url}}"], "path": ["register", "donor"] }
          }
        },
        {
          "name": "إنشاء حساب مستشفى (Register Hospital)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"مستشفى النهضة النموذجي\",\n  \"email\": \"alnahdah3@musaef.com\",\n  \"phone\": \"773334455\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"role\": \"hospital\",\n  \"facility_type\": \"hospital\",\n  \"license_number\": \"HOSP-55612\",\n  \"address\": \"شارع الزبيري - صنعاء\",\n  \"latitude\": 15.352100,\n  \"longitude\": 44.204500\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/register/hospital", "host": ["{{base_url}}"], "path": ["register", "hospital"] }
          }
        },
        {
          "name": "إنشاء حساب بنك دم (Register Blood Bank)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"بنك الدم المركزي الرئيسي\",\n  \"email\": \"bloodbank1@musaef.com\",\n  \"phone\": \"775556677\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"role\": \"hospital\",\n  \"facility_type\": \"blood_bank\",\n  \"license_number\": \"BANK-10022\",\n  \"address\": \"شارع المستشفى الجمهوري - صنعاء\",\n  \"latitude\": 15.348900,\n  \"longitude\": 44.206700\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/register/hospital", "host": ["{{base_url}}"], "path": ["register", "hospital"] }
          }
        },
        {
          "name": "تسجيل الخروج (Logout)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/logout", "host": ["{{base_url}}"], "path": ["logout"] }
          }
        }
      ]
    },
    {
      "name": "2. المستشفى (Hospital)",
      "item": [
        {
          "name": "إنشاء طلب طوارئ",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"blood_type_id\": 1,\n  \"units_required\": 5,\n  \"emergency_level\": \"critical\",\n  \"description\": \"حالة نزيف حاد في قسم الطوارئ\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/hospital/requests", "host": ["{{base_url}}"], "path": ["hospital", "requests"] }
          }
        },
        {
          "name": "عرض مخزون الدم",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/hospital/inventory", "host": ["{{base_url}}"], "path": ["hospital", "inventory"] }
          }
        },
        {
          "name": "تأكيد إتمام التبرع",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"donor_id\": 19,\n  \"emergency_request_id\": 1,\n  \"units_donated\": 1,\n  \"donation_date\": \"2026-07-30 10:00:00\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/donations/confirm", "host": ["{{base_url}}"], "path": ["donations", "confirm"] }
          }
        },
        {
          "name": "تحديث مخزون الدم يدوياً",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"blood_type_id\": 1,\n  \"units\": 10,\n  \"operation\": \"add\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/hospital/inventory/update", "host": ["{{base_url}}"], "path": ["hospital", "inventory", "update"] }
          }
        },
        {
          "name": "تبديل وضع الطوارئ القصوى",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/hospital/emergency-mode/toggle", "host": ["{{base_url}}"], "path": ["hospital", "emergency-mode", "toggle"] }
          }
        }
      ]
    },
    {
      "name": "3. الإدارة والذكاء الاصطناعي (Admin & AI)",
      "item": [
        {
          "name": "إحصائيات الداشبورد",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/admin/dashboard", "host": ["{{base_url}}"], "path": ["admin", "dashboard"] }
          }
        },
        {
          "name": "بيانات الخريطة الحرارية (Heatmap Data)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/admin/analytics/heatmap", "host": ["{{base_url}}"], "path": ["admin", "analytics", "heatmap"] }
          }
        },
        {
          "name": "عرض وتحديث إعدادات النظام المتقدمة والـ AI",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/admin/settings", "host": ["{{base_url}}"], "path": ["admin", "settings"] }
          }
        }
      ]
    },
    {
      "name": "4. المتبرع (Donor)",
      "item": [
        {
          "name": "عرض الملف الشخصي",
