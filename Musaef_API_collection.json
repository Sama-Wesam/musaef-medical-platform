    },
    {
      "name": "5. مسارات عامة (Public)",
      "item": [
        {
          "name": "عرض حالات الطوارئ النشطة",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/emergencies/active", "host": ["{{base_url}}"], "path": ["emergencies", "active"] }
          }
        },
