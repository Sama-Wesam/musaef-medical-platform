# --- Application Configuration ---
APP_NAME="Musaef Medical Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA
APP_TIMEZONE=Asia/Gaza

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- Logging & Diagnostics ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database & Cache Setup ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=musaef_db
DB_USERNAME=root
DB_PASSWORD=

QUEUE_CONNECTION=database
CACHE_STORE=file
CACHE_PREFIX=musaef_cache_

# --- Session & Security ---
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS="localhost,127.0.0.1"

# --- Firebase Cloud Messaging (FCM Push Notifications) ---
FCM_PROJECT_ID=musaef-app
FCM_SERVER_KEY=
FCM_OAUTH_TOKEN=
FCM_SOUND_EMERGENCY=emergency_siren.mp3

# --- Laravel Reverb (Real-time WebSockets) ---
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME=http

REVERB_SERVER=reverb
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# --- AI & External Services ---
# استخدم مسار البيئة الافتراضية النسبي أو الأمر المباشر لتسهيل العمل عبر مختلف أنظمة التشغيل
PYTHON_PATH=".venv/Scripts/python.exe"

# --- Mail Server Settings ---
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@musaef.ps"
MAIL_FROM_NAME="${APP_NAME}"

# --- AWS & Storage ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Frontend Integration (Vite) ---
VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL=http://localhost:8000/api
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
